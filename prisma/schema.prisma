// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  email        String       @unique
  password     String
  fullname     String
  address      Address?
  addressName  String?
  location     Location?
  description  String       @default("We don't know much about you, but we're sure you are great and the profile will be completed soon.")
  userCategory UserCategory @default(VIRTUAL_TOUR_ENTHUSIAST)
  company      String?
  phoneNumber  String?
  avatarUrl    String       @default("https://res.cloudinary.com/dpn7tctut/image/upload/v1687445957/aoa4jflsuikz3wviwete.png")
  coverUrl     String       @default("https://www.klapty.com/public/assets/img/default-cover.png")
  tours        Tour[]
}

model Tour {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  address     Address?
  addressName String?
  location    Location?
  description String        @default("")
  socialImage String        @default("")
  category    TourCategory  @default(NOT_SET)
  encodeUrl   String?       @unique
  config      TourConfig
  statistic   TourStatistic
  createdAt   DateTime      @default(now())
  modifiedAt  DateTime      @default(now())
  floorPlan   FloorPlan?
  creator     User          @relation(fields: [creatorId], references: [id])
  creatorId   String        @db.ObjectId
  scenes      SceneTour[]
}

type TourConfig {
  textColor           String?       @default("#fff")
  soundOption         String?       @default("No Sound")
  enableAutoRotate    Boolean       @default(false)
  autoRotateSpeed     Float         @default(0.0)
  autoHideInfospot    Boolean       @default(false)
  autoHideShareButton Boolean       @default(false)
  lockHorizontalView  Boolean       @default(false)
  privacyStatus       PrivacyStatus @default(PUBLIC)
  editStatus          EditStatus    @default(DRAFT)
  isPasswordProtected Boolean       @default(false)
  password            String?
}

type TourStatistic {
  likeCount Int @default(0)
  viewCount Int @default(0)
}

type Creator {
  userId       String?
  fullname     String?
  avatarUrl    String?
  address      Address?
  addressName  String?
  location     Location?
  description  String?
  userCategory UserCategory?
  phoneNumber  String?
}

type EmbeddedTour {
  id          String?
  name        String?
  address     Address?
  addressName String?
  location    Location?
  description String?       @default("")
  socialImage String?       @default("")
  category    TourCategory? @default(NOT_SET)
  createdAt   DateTime?     @default(now())
  modifiedAt  DateTime?     @default(now())
}

model Scene {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  imageUrl         String
  is2D             Boolean     @default(false)
  thumbnailUrl     String?
  hotspotUrl       String?
  config           SceneConfig
  dateUploaded     DateTime    @default(now())
  dateModified     DateTime    @default(now())
  dimensions       Dimension?
  type             String      @default("image/png")
  previousHotspots Hotspot[]   @relation("Next Scene")
  containHotspots  Hotspot[]   @relation("Contain Scene")
  tours            SceneTour[]
}

type SceneConfig {
  arrivalX Float @default(0.0)
  arrivalY Float @default(0.0)
  arrivalZ Float @default(1)
}

model SceneTour {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId String @db.ObjectId
  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tourId  String @db.ObjectId
  order   Int

  @@unique([sceneId, tourId])
}

model Hotspot {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  config         HotspotConfig
  title          String?
  description    String?
  link           String?
  imageUrl       String?
  soundUrl       String?
  type           HotspotType     @default(INFO)
  transitionType TransitionType?
  containScene   Scene?          @relation("Contain Scene", fields: [containSceneId], references: [id], onDelete: Cascade)
  containSceneId String?         @db.ObjectId
  nextScene      Scene?          @relation("Next Scene", fields: [nextSceneId], references: [id])
  nextSceneId    String?         @db.ObjectId
}

type HotspotConfig {
  scale        Float                 @default(1.0)
  opacity      Float                 @default(1.0)
  rotateDegree Float                 @default(0.0)
  x            Float                 @default(0.0)
  y            Float                 @default(0.0)
  z            Float                 @default(0.0)
  hotspotStyle EmbeddedHotspotStyle?
}

type EmbeddedHotspotStyle {
  id       String
  styleUrl String
  creator  Creator?
  type     HotspotType?
}

model HotspotStyle {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  styleUrl String
  type     HotspotType
  creator  Creator?
}

type FloorPlan {
  floorPlanUrl String
  name         String?
  points       Point[]
}

type Point {
  x       Float
  y       Float
  title   String
  sceneId String
}

// Address is an embedded document
type Address {
  name String
  lat  Float
  lng  Float
}

type Location {
  type        String
  coordinates Float[]
}

type Dimension {
  width  Int
  height Int
}

enum UserCategory {
  REAL_ESTATE_PROFESSIONAL
  PROFESSIONAL_PHOTOGRAPHER
  ARCHITECT_DESIGNER
  DRONE_VIDEOGRAPHER
  COMPANY_SHOP
  VIRTUAL_TOUR_ENTHUSIAST
  OTHER
}

enum TourCategory {
  REAL_ESTATE
  EVENTS_EXHIBITION
  LANDSCAPE_NATURE
  ARTS_DRAWING_CREATIVITY
  TOURISM_HERITAGE_SITES
  BUSINESS_COMPANIES_INDUSTRIES
  SCHOOL_COLLEGES_EDUCATION
  OTHER
  NOT_SET
  ALL
}

enum HotspotType {
  INFO
  TRANSITION
}

enum PrivacyStatus {
  PUBLIC
  PRIVATE
  PASSWORD
  UNLISTED
}

enum EditStatus {
  PUBLISHED
  DRAFT
}

enum TransitionType {
  FADEIN
  PARALLAX
}
