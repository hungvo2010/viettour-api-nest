// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  email        String       @unique
  password     String
  fullname     String
  address      Address?
  description  String       @default("We don't know much about you, but we're sure you are great and the profile will be completed soon.")
  userCategory UserCategory @default(VIRTUAL_TOUR_ENTHUSIAST)
  company      String?
  phoneNumber  String?
  avatarUrl    String       @default("https://media.istockphoto.com/id/1296158947/photo/portrait-of-creative-trendy-black-african-male-designer-laughing.jpg?s=612x612&w=0&k=20&c=1Ws_LSzWjYvegGxHYQkkgVytdpDcnmK0upJyGOzEPcg=")
  coverUrl     String       @default("https://www.klapty.com/public/assets/img/default-cover.png")

  tours EmbeddedTour[]
}

model Tour {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  address             Address?
  description         String        @default("")
  socialImage         String        @default("")
  category            TourCategory  @default(NOT_SET)
  creator             Creator
  logoUrl             String        @default("https://www.kindpng.com/picc/m/286-2864921_blender-logo-blender-3d-logo-hd-png-download.png")
  privacyStatus       PrivacyStatus @default(DRAFT)
  likeCount           Int           @default(0)
  viewCount           Int           @default(0)
  isPasswordProtected Boolean       @default(false)
  password            String?
  createdAt           DateTime      @default(now())
  modifiedAt          DateTime      @default(now())
  floorPlan           FloorPlan?
  scenes              SceneTour[]
}

type Creator {
  userId       String
  fullname     String
  avatarUrl    String
  address      Address?
  description  String
  userCategory UserCategory
  phoneNumber  String?
}

type EmbeddedTour {
  tourId      String?
  name        String?
  address     Address?
  description String?       @default("")
  socialImage String?       @default("")
  category    TourCategory? @default(NOT_SET)
  createdAt   DateTime?     @default(now())
  modifiedAt  DateTime?     @default(now())
}

model Scene {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  imageUrl         String
  soundUrl         String?
  is2D             Boolean     @default(false)
  thumbnailUrl     String?
  hotspotUrl       String?
  enableAutoRotate Boolean     @default(false)
  rotateSpeed      Float       @default(0.0)
  arrivalX         Float       @default(0.0)
  arrivalY         Float       @default(0.0)
  arrivalZ         Float       @default(0.0)
  dateUploaded     DateTime    @default(now())
  dateModified     DateTime    @default(now())
  dimensions       Dimension
  type             String      @default("image/png")
  previousHotspots Hotspot[]   @relation("Next Scene")
  containHotspots  Hotspot[]   @relation("Contain Scene")
  tours            SceneTour[]
}

model SceneTour {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  scene   Scene  @relation(fields: [sceneId], references: [id])
  sceneId String @db.ObjectId
  tour    Tour   @relation(fields: [tourId], references: [id])
  tourId  String @db.ObjectId
  order   Int
}

model Hotspot {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  scale          Float                 @default(1.0)
  opacity        Float                 @default(1.0)
  x              Float                 @default(0.0)
  y              Float                 @default(0.0)
  z              Float                 @default(0.0)
  title          String?
  description    String?
  link           String?
  imageUrl       String?
  soundUrl       String?
  type           HotspotType           @default(INFO)
  hotspotStyle   EmbeddedHotspotStyle?
  transitionType TransitionType?
  containScene   Scene?                @relation("Contain Scene", fields: [containSceneId], references: [id])
  containSceneId String?               @db.ObjectId
  nextScene      Scene?                @relation("Next Scene", fields: [nextSceneId], references: [id])
  nextSceneId    String?               @db.ObjectId
}

type EmbeddedHotspotStyle {
  id       String
  styleUrl String
}

model HotspotStyle {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  styleUrl String
}

type FloorPlan {
  floorPlanUrl String
  dimensions   Dimension
  points       Point[]
}

type Point {
  x       Int
  y       Int
  sceneId String
}

// Address is an embedded document
type Address {
  name String
  lat  Float
  lng  Float
}

type Dimension {
  width  Int
  height Int
}

enum UserCategory {
  REAL_ESTATE_PROFESSIONAL
  PROFESSIONAL_PHOTOGRAPHER
  ARCHITECT_DESIGNER
  DRONE_VIDEOGRAPHER
  COMPANY_SHOP
  VIRTUAL_TOUR_ENTHUSIAST
  OTHER
}

enum TourCategory {
  REAL_ESTATE
  EVENTS_EXHIBITION
  LANDSCAPE_NATURE
  ARTS_DRAWING_CREATIVITY
  TOURISM_HERITAGE_SITES
  BUSINESS_COMPANIES_INDUSTRIES
  SCHOOL_COLLEGES_EDUCATION
  OTHER
  NOT_SET
}

enum HotspotType {
  INFO
  TRANSITION
}

enum PrivacyStatus {
  PUBLIC
  PRIVATE
  DRAFT
}

enum TransitionType {
  FADEIN
  PARALLAX
}
